{
	"name": "pi-filler",
	"version": "0.0.0",
	"description": "Deterministic DOCX and PDF tooling for Pi",
	"keywords": [
		"pi-package",
		"pi-extension",
		"docx",
		"pdf",
		"pandoc",
		"document-processing"
	],
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://gitlab.com/Joao-O-Santos/pi-filler.git"
	},
	"bugs": {
		"url": "https://gitlab.com/Joao-O-Santos/pi-filler/-/issues"
	},
	"homepage": "https://gitlab.com/Joao-O-Santos/pi-filler",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"README.md",
		"logo.png",
		"LICENSE"
	],
	"scripts": {
		"test": "node --import tsx --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint src test scripts",
		"format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts biome.json package.json tsconfig.json",
		"format:fix": "biome check --write src test scripts biome.json package.json tsconfig.json",
		"markdown:check": "node scripts/format-markdown.mjs",
		"markdown:fix": "node scripts/format-markdown.mjs --write",
		"style": "npm run lint && npm run format:check && npm run markdown:check",
		"check": "npm run typecheck && npm run style && npm test",
		"site": "make site"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@earendil-works/pi-ai": "latest",
		"@earendil-works/pi-coding-agent": "latest",
		"@earendil-works/pi-tui": "latest",
		"@types/node": "latest",
		"tsx": "latest",
		"typebox": "latest",
		"typescript": "latest"
	},
	"dependencies": {
		"fast-xml-parser": "latest",
		"fflate": "latest"
	}
}
